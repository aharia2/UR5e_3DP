<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5e">

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur5e"/>
  
  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix=""
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/ur5e/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur5e/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur5e/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur5e/visual_parameters.yaml"

    safety_limits="false"
    safety_pos_margin="0.15"
    safety_k_position="20"
  >
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:ur_robot>

  <link name="world" />

  <link name="floor">
    <visual>
      <geometry>
        <box size="3.048 3.048 0.0254"/>
      </geometry>
      <material name="floor_color">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="3.048 3.048 0.0254"/>
      </geometry>
    </collision>
  </link>

  <joint name="world_to_floor" type="fixed">
    <parent link="world"/>
    <child link="floor"/>
    <origin xyz="0 0 -0.0127" rpy="0 0 0"/>
  </joint>

  <link name="tool_head">
    <visual>
      <geometry>
        <mesh filename="package://ur5e_description/meshes/Toolhead_V3_Assembly.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 -0.09 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.21 0.15"/>
      </geometry>
    </collision>
  </link>

  <joint name="tool_head_joint" type="fixed">
    <parent link="tool0"/>
    <child link="tool_head"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tool_tip">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="tool_tip_joint" type="fixed">
    <parent link="tool_head"/>
    <child link="tool_tip"/>
    <origin xyz="0 -0.185928 0.009144" rpy="0 0 0"/>
  </joint>

</robot>