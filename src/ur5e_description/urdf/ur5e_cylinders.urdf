<?xml version="1.0"?>
<robot name="ur5e">
  <!-- 
    Cylinder-only mock of UR5e to bypass mesh loading crashes.
    Topology matches standard UR5e.
  -->

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.07"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.07"/>
      </geometry>
    </collision>
  </link>

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28" upper="6.28" effort="150" velocity="3.15"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.06"/>
      </geometry>
      <origin rpy="0 1.57 0" xyz="0 0 0"/>
    </visual>
     <collision>
      <geometry>
        <cylinder length="0.15" radius="0.06"/>
      </geometry>
      <origin rpy="0 1.57 0" xyz="0 0 0"/>
    </collision>
  </link>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0.13 0" rpy="0 1.57 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28" upper="6.28" effort="150" velocity="3.15"/>
  </joint>

  <link name="upper_arm_link">
     <visual>
      <geometry>
        <cylinder length="0.425" radius="0.05"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 -0.1 0.21"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.425" radius="0.05"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 -0.1 0.21"/>
    </collision>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 -0.13 0.425" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="150" velocity="3.15"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <geometry>
        <cylinder length="0.39" radius="0.04"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.19"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.39" radius="0.04"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.19"/>
    </collision>
  </link>

  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 0.39" rpy="0 1.57 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28" upper="6.28" effort="28" velocity="3.2"/>
  </joint>

  <link name="wrist_1_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.04"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0.1 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28" upper="6.28" effort="28" velocity="3.2"/>
  </joint>

  <link name="wrist_2_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.04"/>
      </geometry>
    </visual>
     <collision>
      <geometry>
        <cylinder length="0.1" radius="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28" upper="6.28" effort="28" velocity="3.2"/>
  </joint>

  <link name="wrist_3_link">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.03"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.03"/>
      </geometry>
    </collision>
  </link>

  <link name="tool0"/>
  <joint name="flange-tool0" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="tool0"/>
    <origin xyz="0 0.08 0" rpy="-1.57 0 0"/>
  </joint>

</robot>
